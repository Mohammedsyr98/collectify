{
  "name": "@collectify/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./debt-plan": {
      "types": "./src/debt-plan/index.ts",
      "import": "./dist/debt-plan/index.js",
      "default": "./dist/debt-plan/index.js"
    },
    "./money": {
      "types": "./src/money/index.ts",
      "import": "./dist/money/index.js",
      "default": "./dist/money/index.js"
    },
    "./schedule-item-payment": {
      "types": "./src/schedule-item-payment/index.ts",
      "import": "./dist/schedule-item-payment/index.js",
      "default": "./dist/schedule-item-payment/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "debt-plan": ["./src/debt-plan/index.ts"],
      "money": ["./src/money/index.ts"],
      "schedule-item-payment": ["./src/schedule-item-payment/index.ts"]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run && tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@collectify/eslint-config": "workspace:*",
    "@collectify/typescript-config": "workspace:*",
    "eslint": "^9.32.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
